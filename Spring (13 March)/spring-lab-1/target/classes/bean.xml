    <bean id="e1" class="com.cg.bean.Employee">
        <property name="empId" value="101"/>
        <property name="empName" value="Sadiq"/>
        <property name="salary" value="100000"/>
        <property name="businessUnit" value="PES-BU"/>
        <property name="age" value="22"/>
    </bean>

    <bean id="e2" class="com.cg.bean.Employee">
        <property name="empId" value="102"/>
        <property name="empName" value="ABC"/>
        <property name="salary" value="80000"/>
        <property name="businessUnit" value="PES-BU"/>
        <property name="age" value="20"/>
    </bean>

    <bean id="sbu" class="com.cg.bean.SBU">
        <property name="sbuCode" value="PES-BU"/>
        <property name="sbuName" value="Product engineering Services"/>
        <property name="sbuHead" value="Kiran Rao"/>
        <property name="empList">
            <list>
                <ref bean="e1"/>
                <ref bean="e2"/>
            </list>
        </property>
    </bean>



